{
  "name": "deck-tutor-mcp",
  "version": "1.0.0",
  "description": "MCP server providing deck-building context for Deck Tutor",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deck-tutor-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "split-rules": "tsx scripts/splitComprehensiveRules.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "magic-the-gathering",
    "mtg",
    "commander",
    "deck-building",
    "scryfall"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ellentham/deck-tutor-mcp.git"
  },
  "homepage": "https://github.com/ellentham/deck-tutor-mcp#readme",
  "bugs": {
    "url": "https://github.com/ellentham/deck-tutor-mcp/issues"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
